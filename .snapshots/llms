      const url = new URL(href).host;

      return (
        <HoverCard>
          <HoverCardTrigger asChild>
            <Link
              href={href}
              target="_blank"
              data-message-id={messageId}
              className="!my-0 font-normal text-teal-600 !no-underline dark:text-teal-600"
            >
              {text}
            </Link>
          </HoverCardTrigger>
          <HoverCardContent
            sideOffset={12}
            className="flex max-w-[400px] cursor-pointer flex-col items-start rounded-lg p-2"
            onClick={() => {
              window.open(href, "_blank");
            }}
          >
            <Flex gap="sm" items="start" className="w-full text-zinc-500">
              <SearchFavicon link={url} className="!m-0 !mt-1" size="md" />
              <Type
                size="sm"
                textColor="secondary"
                className="line-clamp-2 flex-1"
              >
                {href}
              </Type>
              <ExternalLink
                size={16}
                strokeWidth={2}
                className="mt-1 flex-shrink-0"
